<script>
  function toggleDetails(){
    var el = document.getElementById('aboutDetails');
    var btn = document.querySelector('.view-more-btn');
    el.classList.toggle('show');
    btn.textContent = el.classList.contains('show') ? 'View Less' : 'View More';
  }
</script>

</body>
</html>
